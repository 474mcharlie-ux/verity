# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://verity:verity@db:5432/verity
DATABASE_URL_SYNC=postgresql://verity:***@db:5432/verity

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Companies House ───────────────────────────────────────────────────────────
# Get a free key at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=***

# ── LLM backend: "ollama" (default, fully local) or "anthropic" ──────────────
LLM_BACKEND=ollama

# Hermes via Ollama — runs inside Docker, no data leaves the firm
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=nous-hermes2

# Anthropic (cloud fallback — confirm data handling with firm before enabling)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=3600
